#!wing
#!version=12.0
##################################################################
# Wing project file                                              #
##################################################################
[project attributes]
console.toolbox = [{'add_to_tools_menu': True,
                    'adjust_colors': True,
                    'auto_start': True,
                    'autosave': False,
                    'cmd': 'bash',
                    'context': ('project',
                                ''),
                    'env': ('merge',
                            ['TERM=xterm-256color',
                             'COLORTERM=truecolor']),
                    'forward_mouse': True,
                    'id': 'builtin-terminal',
                    'io_encoding': None,
                    'key_binding': None,
                    'line_mode': False,
                    'pseudo_tty': True,
                    'pypath': ('project',
                               []),
                    'raise_panel': True,
                    'rundir': ('project',
                               ''),
                    'send_keys_to_console': 'pref',
                    'shared': False,
                    'show_in': 'main',
                    'show_in_split': 1,
                    'title': 'Terminal'}]
proj.directory-list = [{'dirloc': loc('.'),
                        'excludes': (),
                        'filter': '*',
                        'include_hidden': False,
                        'recursive': True,
                        'watch_for_changes': True}]
proj.file-type = 'shared'
proj.main-file = loc('examples/booklet.py')
testing.auto-discover = True
testing.test-framework = {None: ':internal pytest'}
